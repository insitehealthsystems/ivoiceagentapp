PORT=3001

# --- Microsoft Foundry -------------------------------------------------
# Endpoint of your Foundry project, e.g. https://<project>.services.ai.azure.com/api/projects/<project-name>
AZURE_FOUNDRY_ENDPOINT=
# The NAME of the deployed iLocate agent (not an "asst_" id -- this targets
# a Foundry declarative agent on the Responses protocol; see README).
AZURE_FOUNDRY_AGENT_NAME=

# --- Azure Speech --------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-JennyNeural

# --- CORS ------------------------------------------------------------------
# Origin of the React dev server (Vite default shown).
CLIENT_ORIGIN=http://localhost:5173

# --- Behavior --------------------------------------------------------------
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
